

import tkinter as tk

# Function to calculate distance
def calculate_distance():

    time = float(time_entry.get())
    speed = float(speed_entry.get())

    distance = time * speed

    result_label.config(
        text="Distance Covered: " + str(distance) + " km"
    )


# Create the main window
window = tk.Tk()
window.title("Distance Calculator")
window.geometry("400x350")
window.configure(bg="lightblue")

# Heading
title = tk.Label(
    window,
    text="Distance Calculator",
    font=("Arial", 18, "bold"),
    bg="lightblue"
)
title.pack(pady=20)

# Time input
time_label = tk.Label(
    window,
    text="Enter Time (hours):",
    bg="lightblue"
)
time_label.pack()

time_entry = tk.Entry(window)
time_entry.pack(pady=5)

# Speed input
speed_label = tk.Label(
    window,
    text="Enter Speed (km/hr):",
    bg="lightblue"
)
speed_label.pack()

speed_entry = tk.Entry(window)
speed_entry.pack(pady=5)

# Calculate button
calculate_button = tk.Button(
    window,
    text="Calculate Distance",
    command=calculate_distance
)
calculate_button.pack(pady=15)

# Result display
result_label = tk.Label(
    window,
    text="Distance will appear here",
    font=("Arial", 12, "bold"),
    bg="lightblue"
)
result_label.pack(pady=10)

# Run the application
window.mainloop()
