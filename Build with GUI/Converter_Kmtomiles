

import tkinter as tk

# Create window
window = tk.Tk()
window.title("Distance Converter")

# Row 0: Label
label1 = tk.Label(window, text="Enter Miles:")
label1.grid(row=0, column=0)

# Row 0: Entry box
entry1 = tk.Entry(window)
entry1.grid(row=0, column=1)

# Function to convert miles into kilometers
def convert():
    miles = float(entry1.get())
    km = miles * 1.6
    result.config(text="Distance in Km: " + str(km))

# Row 1: Convert button
button1 = tk.Button(window, text="Convert", command=convert)
button1.grid(row=1, column=0, columnspan=2)

# Row 2: Result label
result = tk.Label(window, text="Result will appear here")
result.grid(row=2, column=0, columnspan=2)

# Run window
window.mainloop()
