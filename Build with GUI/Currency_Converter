

import tkinter as tk
from tkinter import *

# Create window
window = Tk()
window.title("Currency Converter")

# Create Entry box
label1 = Label(window, text="Enter US Dollars ($):")
label1.grid(row=0, column=0)

entry1 = Entry(window)
entry1.grid(row=0, column=1)

# Function to convert USD into INR
def convert():
    dollars = float(entry1.get())
    rupees = dollars * 83

    # Clear previous result
    result.delete("1.0", END)

    # Insert new result
    result.insert(END, "INR: " + str(rupees))

# Create Convert button
button1 = Button(window, text="Convert", command=convert)
button1.grid(row=1, column=0, columnspan=2)

# Create Text widget
result = Text(window, height=1, width=20)
result.grid(row=2, column=0, columnspan=2)

# Run window
window.mainloop()
