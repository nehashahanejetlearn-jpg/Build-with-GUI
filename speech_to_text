

import tkinter as tk
from tkinter import messagebox
import speech_recognition as sr

# Function to convert speech into text
def convert_speech():
    recognizer = sr.Recognizer()

    try:
        with sr.Microphone() as source:
            status_label.config(text="Listening... Speak now!")
            root.update()

            recognizer.adjust_for_ambient_noise(source)
            audio = recognizer.listen(source)

            status_label.config(text="Converting speech to text...")
            root.update()

        text = recognizer.recognize_google(audio)

        text_box.delete("1.0", tk.END)
        text_box.insert(tk.END, text)

        status_label.config(text="Conversion successful!")

    except sr.UnknownValueError:
        messagebox.showerror("Error", "Sorry, speech not understood.")

    except sr.RequestError:
        messagebox.showerror("Error", "Please check your internet connection.")

    except Exception as e:
        messagebox.showerror("Error", str(e))


# Clear the text box
def clear_text():
    text_box.delete("1.0", tk.END)
    status_label.config(text="Ready to listen")


# Main window
root = tk.Tk()
root.title("Speech to Text Converter")
root.geometry("450x350")

# Heading
heading = tk.Label(
    root,
    text="Speech to Text Converter",
    font=("Arial", 18, "bold")
)
heading.pack(pady=15)

# Instructions
instruction = tk.Label(
    root,
    text="Click the button and speak into your microphone"
)
instruction.pack(pady=5)

# Convert button
convert_button = tk.Button(
    root,
    text="Start Listening",
    command=convert_speech,
    bg="green",
    fg="white",
    font=("Arial", 12)
)
convert_button.pack(pady=10)

# Text box
text_box = tk.Text(root, height=6, width=45)
text_box.pack(pady=10)

# Clear button
clear_button = tk.Button(
    root,
    text="Clear",
    command=clear_text
)
clear_button.pack(pady=5)

# Status label
status_label = tk.Label(root, text="Ready to listen")
status_label.pack(pady=5)

root.mainloop()
