

import tkinter as tk
from tkinter import messagebox
import random

# Generate a random number
secret_number = random.randint(1, 10)

# Create main window
root = tk.Tk()
root.title("Number Guessing Game")
root.geometry("400x350")
root.configure(bg="lightblue")

# Heading
title = tk.Label(
    root,
    text="NUMBER GUESSING GAME",
    font=("Arial", 18, "bold"),
    bg="lightblue"
)
title.place(x=45, y=30)

# Instructions
instruction = tk.Label(
    root,
    text="Guess a number between 1 and 10",
    font=("Arial", 12),
    bg="lightblue"
)
instruction.place(x=65, y=90)

# Entry box
entry = tk.Entry(root, font=("Arial", 16), justify="center")
entry.place(x=130, y=140, width=140)

# Check function
def check_number():
    guess = entry.get()

    if not guess.isdigit():
        messagebox.showwarning("Invalid Input", "Please enter a number!")
        return

    guess = int(guess)

    if guess < 1 or guess > 10:
        messagebox.showwarning("Invalid Number", "Enter a number between 1 and 10!")
    elif guess == secret_number:
        messagebox.showinfo("Congratulations", "You guessed correctly!")
        root.destroy()
    elif guess < secret_number:
        messagebox.showinfo("Try Again", "Your guess is too low!")
        entry.delete(0, tk.END)
    else:
        messagebox.showinfo("Try Again", "Your guess is too high!")
        entry.delete(0, tk.END)

# Check button
check_button = tk.Button(
    root,
    text="CHECK",
    font=("Arial", 12, "bold"),
    bg="green",
    fg="white",
    command=check_number
)
check_button.place(x=150, y=200, width=100)

# Exit button
exit_button = tk.Button(
    root,
    text="EXIT",
    font=("Arial", 12, "bold"),
    command=root.destroy
)
exit_button.place(x=165, y=260, width=70)

# Run application
root.mainloop()
